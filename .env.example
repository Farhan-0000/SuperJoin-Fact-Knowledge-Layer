# ═══════════════════════════════════════════════════════════════════════
# FACT KNOWLEDGE LAYER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your local settings.
# ═══════════════════════════════════════════════════════════════════════

# OpenAI API Key (Required for live fact extraction & LLM fallback reasoning)
# WARNING: NEVER commit your actual API key to version control!
OPENAI_API_KEY=your-openai-api-key-here

# LLM Model Configuration
# Models used for structured fact extraction, embeddings, and relationship reasoning
EXTRACTION_MODEL=gpt-4o-mini
RELATIONSHIP_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Pipeline Performance & Concurrency Limits
MAX_LLM_CONCURRENCY=5
EMBEDDING_BATCH_SIZE=32

# Candidate Retrieval Thresholds
CANDIDATE_MIN_SCORE=0.55
CANDIDATE_TOP_K=20

# Storage & SQLite Database Path
# Local folder for persisted documents and SQLite database
STORAGE_DIR=storage
DATABASE_URL=sqlite+aiosqlite:///storage/facts.db

# OCR & Quality Analysis
OCR_PROVIDER=pymupdf_ocr
LOW_QUALITY_THRESHOLD=0.30

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
