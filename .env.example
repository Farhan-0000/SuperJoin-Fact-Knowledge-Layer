# ── LLM Configuration ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
EXTRACTION_MODEL=gpt-4o
RELATIONSHIP_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── Storage ────────────────────────────────────────────────────────
STORAGE_DIR=./storage
DATABASE_URL=sqlite+aiosqlite:///./storage/facts.db

# ── Concurrency & Limits ──────────────────────────────────────────
MAX_LLM_CONCURRENCY=4
MAX_FILE_SIZE_MB=50

# ── Application ───────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
